{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "plannotator@plannotator": true
  },
  "permissions": {
    "allow": ["mcp__graphify"],
    "ask": [
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr list *)"
    ]
  },
  "autoCompactWindow": 300000,
  "modelSettings": {
    "claude-opus-5-5": { "autoCompactWindow": 200000 },
    "claude-fable-5-1": { "autoCompactWindow": 300000 },
    "claude-fable-5-2": { "autoCompactWindow": 300000 },
    "claude-sonnet-5-5": { "autoCompactWindow": 150000 },
    "claude-haiku-5-5": { "autoCompactWindow": 125000 }
  },
  "extraKnownMarketplaces": {
    "plannotator": { "source": { "source": "github", "repo": "backnotprop/plannotator" } }
  }
}
