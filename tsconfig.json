{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020", "es2021.intl"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    // MB.49 — `scripts/` runs under Node's own type stripping (`node foo.ts`),
    // and ESM there does no extension resolution: `probe-database.ts` importing
    // `./assert-pulled-env` fails with ERR_MODULE_NOT_FOUND, so the `.ts` is
    // required at runtime and this flag is what lets `tsc` accept it. Safe with
    // `noEmit`, which is the condition TypeScript attaches to it; it permits the
    // extension rather than requiring it, so nothing else changes.
    "allowImportingTsExtensions": true,
    "incremental": true,
    // Out of the repo root; `next build` keeps its own under .next/cache.
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // tests/ is listed because `tsc` is the only thing that typechecks it:
  // Vitest strips types rather than checking them, and Playwright does the
  // same for tests/e2e/, so an omission here would not fail anything — it
  // would silently stop checking the suite. The `@ts-expect-error` assertions
  // in tests/db/repository/*.test.ts and tests/support/as-user.type-check.ts are only
  // assertions while this line stands (MB.41).
  "include": [
    "next-env.d.ts",
    "./src/**/*",
    "./tests/**/*",
    "./.next/types/**/*.ts",
    "./next.config.ts",
    "./codegen.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    // The workshop (M12.53): its config, helpers and the stories that live
    // beside the components are checked like any other source. `src/**` already
    // reaches the component stories; the dot-directory is named because a
    // `**` glob skips it otherwise.
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
