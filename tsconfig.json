{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    // MB.49 — `scripts/` runs under Node's own type stripping (`node foo.ts`),
    // and ESM there does no extension resolution: `probe-database.ts` importing
    // `./assert-pulled-env` fails with ERR_MODULE_NOT_FOUND, so the `.ts` is
    // required at runtime and this flag is what lets `tsc` accept it. Safe with
    // `noEmit`, which is the condition TypeScript attaches to it; it permits the
    // extension rather than requiring it, so nothing else changes.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // tests/ is listed because `tsc` is the only thing that typechecks it:
  // Vitest strips types rather than checking them, so an omission here would
  // not fail anything — it would silently stop checking the suite, which is
  // the state e2e/ is already in. The `@ts-expect-error` assertions in
  // tests/db/repository.test.ts and tests/support/as-user.test.ts are only
  // assertions while this line stands (MB.41).
  "include": [
    "next-env.d.ts",
    "./src/**/*",
    "./tests/**/*",
    "./.next/types/**/*.ts",
    "./next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // *.stories.tsx pull @ladle/react's types, whose bundled app sources
    // (typings-for-build/**/*.tsx) don't survive this repo's `strict` on their
    // own and aren't reached by `skipLibCheck` because they ship as .tsx, not
    // .d.ts. The workshop compiles stories through Vite/esbuild, which strips
    // types, so `ladle build` still exercises them; only `tsc` steps back.
    // M0.32 revisits when it adds the first real stories.
    "src/**/*.stories.tsx"
  ]
}
