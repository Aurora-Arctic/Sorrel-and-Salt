{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/support-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/provisional-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/document-mailing",
      "schedule": "0 5 * * *"
    }
  ]
}
