# Build context excludes for Docker/Dockerfile.node and Docker/Dockerfile.e2e
# (context is the repo root — see docker-compose.yaml, M0.12). Neither image
# carries a source layer (MB.42) — only the manifests and, for `headed`, the
# entrypoint script are ever COPY'd — so this file's job is keeping the
# build context small: everything listed here is what `docker build` would
# otherwise send to the daemon before finding out it copies none of it.

# Dependencies — reinstalled inside the image
node_modules

# Next.js / build output
.next
out
.vercel
build
dist
*.tsbuildinfo
tsconfig.tsbuildinfo

# Tests and coverage
coverage
coverage-e2e
playwright-report
blob-report
test-results
playwright/.cache
.vitest

# Version control and CI
.git
.github
.gitignore

# Local env and container state — never bake these in
.env
.env.*
!.env.example
Docker/.env
Docker/claude-home
pgdata
docker-data
*.dump
*.sql.gz

# Editors / OS / scratch
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
._*
.scratch*
tmp
.cache

# Logs
*.log
npm-debug.log*
