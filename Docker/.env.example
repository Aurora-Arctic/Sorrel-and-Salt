# Copy this file to Docker/.env (git-ignored) and fill in the values.
#
# Compose auto-loads Docker/.env — it sits beside docker-compose.yaml, which
# is the Compose project directory for both `make docker-*` and the VS Code
# devcontainer (see .devcontainer/docker-compose.yml). Only the `devcontainer`
# service reads these; `app` / `workshop` / `postgres` do not.

# Long-lived Claude Code OAuth token so the devcontainer's CLI is already
# logged in on start instead of needing `/login` after every rebuild.
# Generate/refresh on the host with `make docker-update-token`
# (`Docker/update-token.sh`), which runs `claude setup-token` and writes the
# result here. macOS stores normal login creds in the Keychain, which can't
# be bind-mounted into a Linux container — hence the token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-XXXXXXXXXXXXXXXXXXXXXXXX

# GitHub personal access token so `gh` (installed by the github-cli
# devcontainer feature) and the create-pr skill work inside the container.
# Set this by hand — `update-token.sh` does not touch it. A fine-grained or
# classic PAT with `repo` + `read:org` is enough for branch push and
# `gh pr create`.
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXX
