# syntax=docker/dockerfile:1

# Node image for local development and CI. claude-docs/docker.md is the
# walkthrough.
#
#   development  dependencies only; the compose `app` service and devcontainer
#   testing      `development` plus what CI needs and a vitest default command
#
# Both stages are Alpine, and Playwright is deliberately absent: its Chromium
# has no musl support, and a browser would add half a gigabyte to the image CI
# and the app share. Neither stage carries source — it arrives from the bind
# mount or checkout-to-app's `cp -a`, which overlays without deleting, so a
# baked-in tree would let a deleted file survive.
# tests/guards/image-source-layer.test.ts allowlists what each Dockerfile may
# COPY.

# deploy.yml and migrate.yml's setup-node must match: Node 22's npm 10 cannot
# read this npm-11 lockfile.
ARG NODE_VERSION=26.6.0

# development — deps only, `npm run dev` on 8000 against the mount
FROM node:${NODE_VERSION}-alpine AS development

# glibc shim for prebuilt native addons; the only `apk` package in this stage.
RUN apk add --no-cache libc6-compat

WORKDIR /app
RUN chown node:node /app
USER node

# Manifests only, so `npm ci` stays cached. Always `npm ci`, never `npm i`.
# The last COPY — see the header.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

ENV NODE_ENV=development
EXPOSE 8000
CMD ["npm", "run", "dev"]

# testing — development + a vitest default command
FROM development AS testing

# What the Alpine base lacks and CI needs: bash (`shell: bash`, pipefail),
# git (actions/checkout), GNU tar and zstd (actions/cache runs inside this
# container, and busybox tar rejects `--posix`).
USER root
RUN apk add --no-cache bash git tar zstd
USER node

ENV NODE_ENV=test
CMD ["npx", "vitest", "run"]
