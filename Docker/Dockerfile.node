# syntax=docker/dockerfile:1

# Node image for local development and CI. claude-docs/docker.md is the
# walkthrough.
#
#   development   dependencies only; the compose `app` service
#   testing       `development` plus what CI needs and a vitest default command
#   review-tools  fetches and checks the review tools; nothing runs from it
#   devcontainer  `development` plus the review tools; the devcontainer only
#
# Every stage is Alpine, and Playwright is deliberately absent: its Chromium
# has no musl support, and a browser would add half a gigabyte to the image CI
# and the app share. No stage carries source — it arrives from the bind
# mount or checkout-to-app's `cp -a`, which overlays without deleting, so a
# baked-in tree would let a deleted file survive. A new COPY source is a
# decision, not a convenience.

# deploy.yml and migrate.yml's setup-node must match: Node 22's npm 10 cannot
# read this npm-11 lockfile. So must Dockerfile.e2e's NODE_VERSION, so the e2e
# build runs on the same Node as every other job.
ARG NODE_VERSION=26.6.0

# development — deps only, `npm run dev` on 8000 against the mount
FROM node:${NODE_VERSION}-alpine AS development

# glibc shim for prebuilt native addons; the only `apk` package in this stage.
RUN apk add --no-cache libc6-compat

WORKDIR /app
RUN chown node:node /app
USER node

# Manifests only, so `npm ci` stays cached. Always `npm ci`, never `npm i`.
# The last COPY — see the header.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

# The lock file's hash, saved where Docker/ensure-deps.sh looks: a fresh
# `node_modules` volume copies it from here, so the first start installs
# nothing twice.
RUN sha256sum package-lock.json | cut -d ' ' -f 1 > node_modules/.lock-sha256

ENV NODE_ENV=development
EXPOSE 8000
CMD ["npm", "run", "dev"]

# testing — development + a vitest default command
FROM development AS testing

# What the Alpine base lacks and CI needs: bash (`shell: bash`, pipefail),
# git (actions/checkout), GNU tar and zstd (actions/cache runs inside this
# container, and busybox tar rejects `--posix`), and jq, which the deploy's
# snapshot step calls when tests/github/workflows/migrate.test.ts runs it.
USER root
RUN apk add --no-cache bash git tar zstd jq
USER node

ENV NODE_ENV=test
CMD ["npx", "vitest", "run"]

# review-tools — difftastic, Plannotator, and the glibc both are built for.
# Every download goes through `fetch`, which checks a pinned SHA-256
# (tests/guards/download-checks.test.ts). Its build tools stay in this stage.
FROM node:${NODE_VERSION}-alpine AS review-tools
ARG TARGETARCH
RUN apk add --no-cache binutils curl xz
WORKDIR /stage
RUN <<'EOF'
set -eu
fetch() { curl -fsSL --retry 3 -o "$2" "$1" && echo "$3  $2" | sha256sum -c -; }
# snapshot.debian.org keeps every file at a fixed URL; the mirrors drop a
# package once a point release replaces it.
DEBIAN=https://snapshot.debian.org/archive/debian/20261118T000000Z/pool/main/g
DIFFT=https://github.com/Wilfred/difftastic/releases/download/0.72.0
PLANNOTATOR=https://github.com/backnotprop/plannotator/releases/download/v0.28.67
case "$TARGETARCH" in
  arm64)
    TRIPLET=aarch64-linux-gnu LOADER=usr/lib/ld-linux-aarch64.so.1 ASSET=plannotator-linux-arm64
    fetch "$DEBIAN/glibc/libc6_2.41-12%2Bdeb13u4_arm64.deb" libc6.deb 8784eda966b189c777a384dac5ce009e8fc9b52d006926c5a013e7fa8aa688cc
    fetch "$DEBIAN/gcc-14/libgcc-s1_14.2.0-19_arm64.deb" libgcc-s1.deb 1108bc87879833d6d9a145f22a4a15cddb34e065b4b5f4b97bee586adbac2851
    fetch "$DEBIAN/gcc-14/libstdc%2B%2B6_14.2.0-19_arm64.deb" libstdc++6.deb 6669b0c52a2e7c6af9adfdabce3ff6e286065cdfbc7b85280862b5f799daebee
    # No musl build for aarch64; the glibc one runs on the base's libc6-compat.
    fetch "$DIFFT/difft-0.72.0-aarch64-unknown-linux-gnu.tar.gz" difft.tar.gz 0993a82a6708a24adc6c6b8de366924728ed08f537a5b488940082c8edc79353
    fetch "$PLANNOTATOR/$ASSET" "$ASSET" 9b363302ded9719e5e7eb359e54a63a6d3d79fa77d629276cf7fc581567927cb
    fetch "$PLANNOTATOR/$ASSET.sha256" plannotator.sha256 691de1b0e9dee7e66aafefce1bf626520f52c63cf183d31170be9aced49418e7
    ;;
  amd64)
    TRIPLET=x86_64-linux-gnu LOADER=usr/lib64/ld-linux-x86-64.so.2 ASSET=plannotator-linux-x64
    fetch "$DEBIAN/glibc/libc6_2.41-12%2Bdeb13u4_amd64.deb" libc6.deb 967aa62605721081c3eb2a17650611a792aa802d76a6511d1840242623d204c9
    fetch "$DEBIAN/gcc-14/libgcc-s1_14.2.0-19_amd64.deb" libgcc-s1.deb 3c71917b490d1a17aed43196a2787a256ecf060526cdb20216a74bedc061b150
    fetch "$DEBIAN/gcc-14/libstdc%2B%2B6_14.2.0-19_amd64.deb" libstdc++6.deb ab1fa05837aa7a92aae748fd07a18a35f7d18bb4a71c4724fe2bbf0e32089de0
    fetch "$DIFFT/difft-0.72.0-x86_64-unknown-linux-musl.tar.gz" difft.tar.gz 27b9c1fe038a95682eed241265a3cacb781227730f106104b617e10067d38ff4
    fetch "$PLANNOTATOR/$ASSET" "$ASSET" 39335905cd9539442d7ae83094a464c7969ee55628bb89105016e497f7e687eb
    fetch "$PLANNOTATOR/$ASSET.sha256" plannotator.sha256 b5693fe827f12914ec83be9d53a7453dc06f38f1c78568c8b01c1c9d001c43cd
    ;;
  *)
    echo "review-tools: no build for $TARGETARCH" >&2
    exit 1
    ;;
esac
# The release's own .sha256 file, beside the pin above.
sha256sum -c plannotator.sha256

mkdir -p /opt/glibc /opt/plannotator /opt/review-bin
for deb in libc6.deb libgcc-s1.deb libstdc++6.deb; do
  ar x "$deb" data.tar.xz
  tar -xJf data.tar.xz -C /opt/glibc
  rm data.tar.xz
done
install -m 755 "$ASSET" /opt/plannotator/plannotator
tar -xzf difft.tar.gz -C /opt/review-bin difft

# Plannotator re-runs its own executable path (`plannotator inbox`), so that path
# must be the real binary, not the glibc loader. Two edits inside the ELF
# headers, with the file size unchanged (a longer interpreter or RUNPATH makes
# the tool that grows the file corrupt the bundle appended to it):
#  - PT_INTERP becomes /opt/glibc/ld.so, a symlink to the glibc loader;
#  - the unused DT_DEBUG entry becomes DT_RUNPATH = $ORIGIN, whose string sits
#    in the old interpreter's bytes, and each library the binary needs is
#    symlinked beside it. No LD_LIBRARY_PATH, so the git and shells it starts
#    keep the system's musl, and the Alpine gcompat shim in /lib is not picked.
ln -s /opt/glibc/$LOADER /opt/glibc/ld.so
node - /opt/plannotator/plannotator /opt/glibc/ld.so /opt/glibc/usr/lib/$TRIPLET <<'JS'
const fs = require('fs');
const [file, interp, libs] = process.argv.slice(2);
const runpath = '$ORIGIN';
const fd = fs.openSync(file, 'r+');
const read = (len, pos) => {
  const b = Buffer.alloc(len);
  fs.readSync(fd, b, 0, len, pos);
  return b;
};
const h = read(64, 0);
const phoff = Number(h.readBigUInt64LE(32));
const phsz = h.readUInt16LE(54);
const phn = h.readUInt16LE(56);
const ph = [];
for (let i = 0; i < phn; i++) {
  const p = read(phsz, phoff + i * phsz);
  ph.push({
    t: p.readUInt32LE(0),
    off: Number(p.readBigUInt64LE(8)),
    va: p.readBigUInt64LE(16),
    fsz: Number(p.readBigUInt64LE(32)),
  });
}
const I = ph.find((p) => p.t === 3);
const D = ph.find((p) => p.t === 2);
if (!I || !D) throw new Error('no PT_INTERP or PT_DYNAMIC');
const strs = Buffer.from(interp + '\0' + runpath + '\0');
if (strs.length > I.fsz) throw new Error('interpreter and RUNPATH need ' + strs.length + ' bytes, PT_INTERP has ' + I.fsz);
const d = read(D.fsz, D.off);
let strtab = null;
let strsz = 0;
let dbg = -1;
const needed = [];
for (let j = 0; j < D.fsz; j += 16) {
  const tag = Number(d.readBigInt64LE(j));
  const val = d.readBigUInt64LE(j + 8);
  if (tag === 0) break;
  if (tag === 5) strtab = val;
  if (tag === 10) strsz = Number(val);
  if (tag === 21) dbg = j;
  if (tag === 1) needed.push(Number(val));
}
if (strtab === null || dbg < 0) throw new Error('no DT_STRTAB or DT_DEBUG');
// The dynamic string table is mapped at its own address, so read it from the
// segment that contains it.
const seg = ph.find((p) => p.t === 1 && p.va <= strtab && strtab < p.va + BigInt(p.fsz));
const stroff = Number(strtab - seg.va) + seg.off;
const names = needed.map((o) => {
  const b = read(256, stroff + o);
  return b.toString('latin1', 0, b.indexOf(0));
});
const pad = Buffer.alloc(I.fsz);
strs.copy(pad);
fs.writeSync(fd, pad, 0, I.fsz, I.off);
// DT_RUNPATH (29), pointing at the string just written, as an offset from the
// string table (it wraps, because the string lies below the table).
const e = Buffer.alloc(16);
e.writeBigInt64LE(29n, 0);
e.writeBigUInt64LE((I.va + BigInt(interp.length + 1) - strtab) & 0xffffffffffffffffn, 8);
fs.writeSync(fd, e, 0, 16, D.off + dbg);
const dir = file.replace(/\/[^/]*$/, '');
for (const n of names) {
  if (!fs.existsSync(libs + '/' + n)) throw new Error('glibc has no ' + n);
  fs.symlinkSync(libs + '/' + n, dir + '/' + n);
}
JS

cat > /opt/review-bin/plannotator <<'WRAPPER'
#!/bin/sh
# Plannotator is built for glibc and has no musl build; its interpreter and
# library path are patched in the binary itself (above), so this only sets the
# environment and runs it directly.
export PLANNOTATOR_REMOTE=1 PLANNOTATOR_PORT=19432 PLANNOTATOR_SHARE=disabled
export PLANNOTATOR_UPDATE_CHECK=0 PLANNOTATOR_JINA=0
exec /opt/plannotator/plannotator "$@"
WRAPPER
chmod 755 /opt/review-bin/plannotator /opt/review-bin/difft
EOF

# devcontainer — `development` plus the review tools. A stage of its own, so
# the image `app` and CI build carries none of it. The glibc prefix sits
# outside the system library paths, so no other program loads it.
FROM development AS devcontainer
COPY --from=review-tools /opt/glibc /opt/glibc
COPY --from=review-tools /opt/plannotator /opt/plannotator
COPY --from=review-tools /opt/review-bin/ /usr/local/bin/
USER root
# Plannotator’s code navigation runs `rg` from PATH.
RUN apk add --no-cache ripgrep
# The dft alias, in the system config: writing ~/.gitconfig here or at container
# create stops VS Code copying the host’s name and email into the container.
RUN printf '[alias]\n\tdft = -c diff.external=difft diff\n' >> /etc/gitconfig
USER node
EXPOSE 19432
