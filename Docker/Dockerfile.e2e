# syntax=docker/dockerfile:1

# Playwright e2e image, built by build-e2e-image.yml for CI and by the `e2e`
# compose service locally. Playwright's Chromium has no musl support, so it
# cannot ride in the Alpine Dockerfile.node. The workflow is in
# claude-docs/ci.md, "Reusable checks"; the compose side in claude-docs/docker.md.
#
# PLAYWRIGHT_VERSION must move in lockstep with `@playwright/test` in
# package-lock.json; a mismatch is Playwright's usual "browser not found".
#
# Two stages: `e2e` (headless; CI and `make docker-e2e`) and `headed` (a
# display for `playwright-server`). `docker build` with no `--target` picks
# the LAST stage, so every `e2e` consumer pins `target: e2e`.
ARG PLAYWRIGHT_VERSION=1.63.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble AS e2e

WORKDIR /app

# No source layer, as in Dockerfile.node: checkout-to-app's `cp -a` overlays
# without deleting. tests/guards/image-source-layer.test.ts pins what may be
# COPY'd.
COPY package.json package-lock.json ./
RUN npm ci

# A no-op when the versions agree; a disagreement fails the build here rather
# than the test run.
RUN npx playwright install --with-deps chromium

ENV NODE_ENV=test

# A virtual display for codegen, page.pause() and UI mode's locator picker;
# only `playwright-server` builds it.
FROM e2e AS headed

USER root

# `xvfb` and `websockify` already arrive with the base image and `novnc`;
# named anyway. `openbox` is not optional: without a window manager the
# Chromium and Inspector windows overlap unmovably.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    && rm -rf /var/lib/apt/lists/*

# novnc's landing page is `vnc.html`; without the symlink :7900's root is a
# directory listing.
RUN ln -s vnc.html /usr/share/novnc/index.html

# The one file baked beyond the manifests, so a bare `docker run` has
# something to exec; the compose bind mount shadows it.
# image-source-layer.test.ts allows exactly this path.
COPY Docker/playwright-entrypoint.sh Docker/playwright-entrypoint.sh
RUN chmod +x Docker/playwright-entrypoint.sh

ENTRYPOINT ["/app/Docker/playwright-entrypoint.sh"]
