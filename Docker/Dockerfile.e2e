# syntax=docker/dockerfile:1

# Sorrel & Salt — dedicated Playwright e2e image (M1.14).
#
# Docker/Dockerfile.node's `testing` stage deliberately excludes Playwright's
# system libraries and browser download (see that file's header comment) —
# it's built on Alpine/musl, and Playwright's Chromium build has no official
# Alpine/musl support at all, so bolting it on there isn't an option. The
# `playwright` CI job (.github/workflows/playwright.yml) gets its own image
# instead, mirroring the pattern `build-image.yml` (shared `testing` image)
# and `build-db-image.yml` (preseeded Postgres image) already establish:
# built and published by `build-e2e-image.yml` under a content-addressed
# GHCR tag.
#
# Based on Microsoft's own Playwright image rather than hand-rolling
# `apt-get`/`playwright install --with-deps` on a plain Debian base — it
# already bundles a matching Node.js runtime, every OS library Chromium
# needs, and the Chromium build itself, all pinned together for one exact
# Playwright release. That pin must move in lockstep with `@playwright/test`
# in package.json/package-lock.json (currently 1.63.0) — a mismatched
# browser/library version is Playwright's single most common "browser not
# found" / "host system is missing dependencies" failure, and this Dockerfile
# is the one place that version is duplicated outside package-lock.json.
#
# `Docker/docker-compose.yaml`'s opt-in `e2e` service (profile: e2e) builds
# this same file for local use, so a devcontainer session can run the full
# e2e suite without switching its own Alpine base image — see that file's
# comment for why sharing the image beats duplicating the install steps
# across two different base distros.
#
# Two stages (MB.23). `e2e` — the original, unnamed-until-now stage — is
# what CI and `make docker-e2e` build: headless, no display, nothing extra.
# `headed` adds a virtual display (Xvfb), a window manager, and a
# browser-reachable VNC/noVNC layer on top of it, for `playwright-server`
# (Docker/docker-compose.yaml) to `exec` `playwright codegen` and
# `page.pause()` into. Naming matters here: `docker build` with no `--target`
# picks whichever stage is *last* in the file, so `e2e` must stay named and
# `build-e2e-image.yml` / the `e2e` compose service must pin `target: e2e`
# explicitly — see those files. Both stages must move in lockstep with
# PLAYWRIGHT_VERSION below and `@playwright/test` in package.json — see the
# version-drift warning further down; `headed` is a separate stage rather
# than folded into `e2e` because CI pulls this image on every `playwright`
# job and has no use for a display it never opens.
ARG PLAYWRIGHT_VERSION=1.63.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble AS e2e

WORKDIR /app

# Dependency layer first, same as Dockerfile.node, so an unrelated source
# change never invalidates `npm ci`.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Fast no-op in the normal case — the base image already ships this exact
# version's Chromium build. Real insurance against the version-drift failure
# mode described above: if PLAYWRIGHT_VERSION above and package-lock.json's
# resolved @playwright/test version ever disagree, this is what surfaces it
# as a build-time failure instead of a confusing CI test failure later.
RUN npx playwright install --with-deps chromium

ENV NODE_ENV=test

# `headed` (MB.23) — same image, plus a virtual display so headed/interactive
# Playwright (codegen, page.pause()'s Inspector, UI mode's live locator
# picker) has somewhere to draw. Only `playwright-server`
# (Docker/docker-compose.yaml) builds this stage; CI and `make docker-e2e`
# pin `target: e2e` and never see it.
FROM e2e AS headed

USER root

# `xvfb` is installed unconditionally rather than assumed present —
# `playwright install --with-deps` above covers Chromium's own libraries,
# not a display server, and this apt-get is a no-op if it's already there.
# Verify with `which Xvfb` in a shell on this stage if that ever needs
# confirming. `x11vnc` + `novnc` + `websockify` make the display reachable
# from an ordinary browser tab at :7900 (Docker/docker-compose.yaml
# publishes it). `openbox` is not optional: without a window manager the
# Chromium and Inspector windows are unmovable and overlap, which is the
# single most likely thing to go wrong when testing this stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    && rm -rf /var/lib/apt/lists/*

# The `novnc` apt package's landing page is `vnc.html`, not `index.html` —
# `websockify --web=/usr/share/novnc` (playwright-entrypoint.sh) serves this
# directory as a plain static file server, so without this symlink,
# opening the bare :7900 root serves a directory listing instead of the
# client. `?autoconnect=true&resize=remote` isn't baked into the symlink
# target on purpose: this stays a plain redirect to the same file `vnc.html`
# already is, not a second copy to keep in sync.
RUN ln -s vnc.html /usr/share/novnc/index.html

# The script itself already landed at Docker/playwright-entrypoint.sh via
# the `e2e` stage's `COPY . .` above; just make it executable. At runtime
# `playwright-server`'s bind mount (Docker/docker-compose.yaml, `..:/app`)
# shadows this baked-in copy with the host's own working tree, same as every
# other file here — this chmod is what makes a bare `docker run` of this
# stage (no bind mount) work too.
RUN chmod +x Docker/playwright-entrypoint.sh

ENTRYPOINT ["/app/Docker/playwright-entrypoint.sh"]
