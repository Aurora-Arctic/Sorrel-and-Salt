# syntax=docker/dockerfile:1

# Postgres 18 image for CI and docker-compose; the walkthrough is
# claude-docs/ci.md, "Database image".
#
# Baked in at build time: pg_trgm, an empty `sorrel_template` to clone, and
# the `sorrel` role/database. No schema and no seed data, ever — `db-init` and
# the test harness populate those at runtime, so a migration never rebuilds
# this image.
#
# Build time rather than first boot, because a populated PGDATA is what Docker
# copies into a fresh named volume. The official entrypoint's last line
# `exec "$@"`s into a foreground server, so it is neutered for that one run
# and restored after.
FROM postgres:18

ENV PGDATA=/var/lib/postgresql/data
ENV POSTGRES_DB=sorrel_template

COPY Docker/postgres-init/enable-extensions.sql /docker-entrypoint-initdb.d/

# initdb needs a superuser password. Exported in-shell, never ARG/ENV (GitHub's
# SecretsUsedInArgOrEnv check, and a layer would carry it);
# POSTGRES_HOST_AUTH_METHOD=trust would bake passwordless auth into
# pg_hba.conf. Discarded when the step ends; nothing reads it again.
RUN set -eux; \
	export POSTGRES_PASSWORD="$(head -c 32 /dev/urandom | base64)"; \
	sed -ri 's/^[[:blank:]]*exec "\$@"[[:blank:]]*$/echo "sorrel: build-time init complete, not starting postgres"/' /usr/local/bin/docker-entrypoint.sh; \
	/usr/local/bin/docker-entrypoint.sh postgres; \
	sed -ri 's/^echo "sorrel: build-time init complete, not starting postgres"$/\texec "$@"/' /usr/local/bin/docker-entrypoint.sh; \
	grep -qF 'exec "$@"' /usr/local/bin/docker-entrypoint.sh
