{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "resolveNestedSelectors": true
      }
    ],
    "scss/at-function-pattern": "^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": ["currentColor"],
        "ignoreProperties": ["/^\\$font-/"]
      }
    ],
    "number-max-precision": 5,
    "at-rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "scss/dollar-variable-empty-line-before": null,
    "scss/double-slash-comment-empty-line-before": null,
    "scss/comment-no-empty": null,
    "scss/operator-no-newline-after": null,
    "scss/at-if-no-null": null,
    "color-hex-length": null,
    "color-function-notation": null,
    "color-function-alias-notation": null,
    "alpha-value-notation": null,
    "media-feature-range-notation": null,
    "plugin/use-baseline": [
      true,
      {
        "available": "widely",
        "ignoreAtRules": ["function"],
        "ignoreFunctions": ["light-dark"]
      }
    ],
    "declaration-property-value-allowed-list": {
      "font-family": ["/^\\$font-/", "inherit"],
      "font": ["inherit"],
      "font-size": [
        "/^\\$/",
        "/^(type|heading)-size\\(/",
        "/^calc\\(.*(type|heading)-size\\(/",
        "/^[0-9.]+em$/",
        "0",
        "inherit"
      ],
      "z-index": ["/^layer\\(/", "/^\\$/", "/^-?[0-9]$/"]
    },
    "declaration-property-value-disallowed-list": {
      "/.*/": ["/\\b(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\(\\s*[-.0-9]/"]
    }
  },
  "overrides": [
    {
      "files": ["src/scss/_variables.scss"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "declaration-property-value-allowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ],
  "plugins": ["stylelint-plugin-use-baseline"]
}
