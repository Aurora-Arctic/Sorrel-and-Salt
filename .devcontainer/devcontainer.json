{
  "name": "sorrel-and-salt",
  "dockerComposeFile": ["../Docker/docker-compose.yaml", "docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/app",
  // Closing VS Code leaves the stack running, as `make devcontainer-up` does; `make docker-down` stops it.
  "shutdownAction": "none",
  "overrideCommand": false,
  "initializeCommand": "mkdir -p \"${localWorkspaceFolder}/Docker/claude-home\" \"${localWorkspaceFolder}/Docker/plannotator-home\" \"${localWorkspaceFolder}/Docker/agents-home\" \"${localWorkspaceFolder}/graphify-out\"",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "node",
      "upgradePackages": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "postCreateCommand": "sudo apk add --no-cache github-cli socat && { gh extension install github/gh-stack || echo 'gh-stack was not installed; run: gh extension install github/gh-stack'; }",
  // Starts the Plannotator Inbox with the container, so agents can post to it from the first session.
  // `forward` passes port 43502 on to the Inbox, which listens on the container's loopback alone, so
  // the port compose publishes can reach it with no editor attached (claude-docs/docker.md).
  "postStartCommand": {
    "inbox": "plannotator inbox --background --no-open || echo 'The Plannotator Inbox did not start; run: plannotator inbox --background --no-open'",
    "forward": "setsid -f socat TCP-LISTEN:43502,fork,reuseaddr TCP:127.0.0.1:43501 > /dev/null 2>&1"
  },
  "forwardPorts": [
    8000, 8001, 4983, 3456, 9229, 9230, 9231, 9323, 9324, 51204, 7900, 19432, 19433, 19434, 19435,
    19436, 43501
  ],
  "portsAttributes": {
    "8000": { "label": "next dev" },
    "8001": { "label": "next start (production build)" },
    "4983": { "label": "drizzle studio" },
    "3456": { "label": "workflow job viewer" },
    "9229": { "label": "node inspector (next dev --inspect)" },
    "9230": { "label": "node inspector (vitest --inspect-brk)" },
    "9231": { "label": "node inspector (playwright runner --inspect-brk)" },
    "9323": { "label": "playwright trace viewer" },
    "9324": { "label": "playwright ui mode" },
    "51204": { "label": "vitest ui" },
    "7900": { "label": "playwright display (codegen / page.pause)" },
    "19432": { "label": "plannotator review page" },
    "19433": { "label": "plannotator review page" },
    "19434": { "label": "plannotator review page" },
    "19435": { "label": "plannotator review page" },
    "19436": { "label": "plannotator review page" }
  },
  "remoteUser": "node",
  "containerUser": "node",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "explicit"
        },
        "oxc.enable.oxfmt": false
      },
      "extensions": [
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "Anthropic.claude-code",
        "vitest.explorer",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "GraphQL.vscode-graphql-syntax",
        "usernamehw.errorlens",
        "christian-kohler.path-intellisense",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
