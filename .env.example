# Copy this file to .env.local (git-ignored) with `npm run setup`, which never overwrites one you already have.
# It names every variable src/ and scripts/ read, and tests/guards/env-example.test.ts keeps it that way.
# A blank value means unset. A variable the shell or Docker compose already sets wins over this file.
# What each one is in each deployed environment: claude-docs/secrets.md, "Every variable".

# The Postgres database the app, the seed and the migrations use; this is the one Docker compose runs.
DATABASE_URL=postgres://sorrel:sorrel@postgres:5432/sorrel

# The key that signs sessions and email links; this local value is not a secret and is never used on a deployment.
BETTER_AUTH_SECRET=local-dev-not-a-real-secret
# A list of versioned auth secrets, used only while rotating the one above.
BETTER_AUTH_SECRETS=
# A fallback signing key for email links when the auth secret is unset.
AUTH_SECRET=

# The address made keeper when it first signs in with a verified provider account.
ADMIN_BOOTSTRAP_EMAIL=placeholder@admin-bootstrap.invalid

# The bearer token Vercel Cron sends to the daily job routes; while blank, those routes refuse every call.
CRON_SECRET=

# Where mail goes: resend, mailtrap or mailpit; while blank, mail is written to the server log instead.
MAIL_TRANSPORT=
# The sender address Resend mails from.
MAIL_FROM=
# The Resend account key.
RESEND_API_KEY=
# The Mailtrap sandbox inbox that captures mail.
MAILTRAP_SANDBOX_ID=
# The Mailtrap sandbox key.
MAILTRAP_SANDBOX_TOKEN=
# The local Mailpit server that captures mail when MAIL_TRANSPORT is mailpit.
MAILPIT_URL=http://mailpit:8025

# Sign-in providers: a provider appears on the sign-in page only when both its id and its secret are set.
# The Google app's client id.
GOOGLE_CLIENT_ID=
# The Google app's client secret.
GOOGLE_CLIENT_SECRET=
# The Discord app's client id.
DISCORD_CLIENT_ID=
# The Discord app's client secret.
DISCORD_CLIENT_SECRET=
# The Facebook app's client id.
FACEBOOK_CLIENT_ID=
# The Facebook app's client secret.
FACEBOOK_CLIENT_SECRET=
# The Microsoft app's client id.
MICROSOFT_CLIENT_ID=
# The Microsoft app's client secret.
MICROSOFT_CLIENT_SECRET=
# The Microsoft tenant to sign in against; blank means common, which lets personal accounts in.
MICROSOFT_TENANT_ID=

# Set to true to let a keeper act as another user; it never works on production.
ENABLE_IMPERSONATION=
# Set to true by the end-to-end runner so its session cookie works over plain http.
E2E_PLAIN_SESSION_COOKIE=
# Set to 1 to print every SQL statement the app runs.
DEBUG_SQL=
# Which data `npm run db:seed` loads: minimal, standard or demo.
SEED_SCENARIO=minimal
# A path in front of every API address, set only by the component workshop's build.
WORKSHOP_API_PREFIX=

# Script inputs, each set on the command line for one run.
# The migration files the destructive-DDL check scans, instead of the ones changed on the branch.
DESTRUCTIVE_DDL_FILES=
# The Asana access token the board migration script reads.
ASANA_PAT=
# The host of the Chrome that the Lighthouse script drives; the devcontainer sets it.
LIGHTHOUSE_CDP_HOST=
# The port of that Chrome; the devcontainer sets it.
LIGHTHOUSE_CDP_PORT=
# The address of the shared Playwright browser server; the devcontainer sets it.
PLAYWRIGHT_WS_ENDPOINT=
