{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "rules": {
    "no-console": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/db/connection", "**/db/connection.ts", "./connection", "./connection.ts"],
            "message": "Import the database client only in src/db/repository.ts (CLAUDE.md rule 2) — everything else reaches the database through a service, and writes go through withAudit(session, fn). The handful of files that legitimately need a client rather than a writer carry an oxlint-disable-next-line saying why."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["public", ".next", "out"],
  "overrides": [
    {
      "files": [
        "next.config.ts",
        "drizzle.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        ".ladle/*.{ts,mjs}",
        "e2e/**/*.ts",
        "Docker/clean.js",
        "scripts/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}", ".ladle/*.tsx"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["src/db/**/*.ts", "src/app/**/route.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
