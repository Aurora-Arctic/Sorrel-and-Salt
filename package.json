{
  "name": "sorrel-and-salt",
  "private": true,
  "description": "A compendium, ingredient store and grimoire.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8000",
    "dev:debug": "next dev --inspect=0.0.0.0:9229 --hostname 0.0.0.0 --port 8000",
    "build": "NODE_ENV=production next build",
    "start": "next start --hostname 0.0.0.0 --port \"${PORT:-8000}\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:destructive-ddl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-destructive-ddl.ts",
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:stories": "vitest run --config vitest.stories.config.mts",
    "test:debug": "vitest run --inspectBrk=0.0.0.0:9230 --no-file-parallelism --maxWorkers=1",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui --ui-host 0.0.0.0 --ui-port 9324",
    "e2e:debug": "playwright test --debug",
    "e2e:trace": "playwright show-trace --host 0.0.0.0 --port 9323",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:categories": "tsx scripts/db-seed.ts categories",
    "db:seed:forms": "tsx scripts/db-seed.ts forms",
    "db:drop": "tsx scripts/db-seed.ts drop",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio --host 0.0.0.0 --port 4983",
    "codegen": "graphql-codegen --config codegen.ts",
    "workshop": "ladle serve",
    "workshop:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-workshop.ts"
  },
  "pre-commit": [
    "lint",
    "format:check",
    "typecheck"
  ],
  "dependencies": {
    "@better-auth/core": "^1.7.6",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.1",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-complexity": "^4.2.3",
    "@pothos/plugin-relay": "^4.8.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.104.0",
    "altair-static": "^8.5.9",
    "better-auth": "^1.7.6",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.1",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "monocart-coverage-reports": "^2.13.0",
    "msw": "^2.15.0",
    "oxlint": "^1.83.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.8",
    "react-server-dom-webpack": "19.3.0",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "pre-commit@2.0.0": true
  }
}
