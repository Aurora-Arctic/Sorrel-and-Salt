{
  "name": "sorrel-and-salt",
  "private": true,
  "description": "A compendium, ingredient store and grimoire.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port \"${PORT:-8000}\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck"
  },
  "pre-commit": [
    "lint",
    "format:check",
    "typecheck"
  ],
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.82.0",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "pre-commit@2.0.0": true
  }
}
