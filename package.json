{
  "name": "sorrel-and-salt",
  "private": true,
  "description": "A compendium, ingredient store and grimoire.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8000",
    "dev:debug": "next dev --inspect=0.0.0.0:9229 --hostname 0.0.0.0 --port 8000",
    "build": "NODE_ENV=production next build",
    "start": "next start --hostname 0.0.0.0 --port \"${PORT:-8000}\"",
    "typecheck": "tsc --noEmit",
    "lighthouse:seo": "node scripts/lighthouse-seo.mjs",
    "lint": "oxlint . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.scss\" \".storybook/**/*.scss\"",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:destructive-ddl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-destructive-ddl.ts",
    "check:migration-order": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-migration-order.ts",
    "pre-commit": "lint-staged --diff=HEAD --continue-on-error",
    "pre-commit:staged": "lint-staged --hide-unstaged --continue-on-error",
    "test": "flock /tmp/sorrel-vitest.lock vitest run",
    "test:coverage": "flock /tmp/sorrel-vitest.lock vitest run --coverage",
    "test:stories": "flock /tmp/sorrel-e2e.lock playwright test --config playwright.stories.config.ts",
    "test:debug": "vitest run --inspectBrk=0.0.0.0:9230 --no-file-parallelism --maxWorkers=1",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:audit": "E2E_AUDIT=1 flock /tmp/sorrel-e2e.lock playwright test --project webkit --project firefox --project phone",
    "test:stories:audit": "E2E_AUDIT=1 flock /tmp/sorrel-e2e.lock playwright test --config playwright.stories.config.ts --project webkit --project firefox --project phone",
    "e2e:servers": "tsx scripts/e2e-servers.ts",
    "e2e:ui": "playwright test --ui --ui-host 0.0.0.0 --ui-port 9324",
    "e2e:debug": "playwright test --debug",
    "e2e:trace": "playwright show-trace --host 0.0.0.0 --port 9323",
    "e2e:workshop": "playwright test --config playwright.workshop.config.ts",
    "workshop:check": "playwright test --config playwright.workshop-check.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:categories": "tsx scripts/db-seed.ts categories",
    "db:seed:forms": "tsx scripts/db-seed.ts forms",
    "db:seed:astrology": "tsx scripts/db-seed.ts astrology",
    "db:seed:deities": "tsx scripts/db-seed.ts deities",
    "db:seed:sources": "tsx scripts/db-seed.ts sources",
    "db:seed:compendium": "tsx scripts/db-seed.ts compendium",
    "db:seed:reference": "tsx scripts/db-seed.ts reference",
    "db:drop": "tsx scripts/db-seed.ts drop",
    "seed:mark": "tsx scripts/seed-mark.ts",
    "seed:queue": "tsx scripts/seed-queue.ts",
    "compendium:audit": "tsx scripts/compendium-audit.ts",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
    "db:reset:demo": "SEED_SCENARIO=demo npm run db:reset",
    "db:studio": "drizzle-kit studio --host 0.0.0.0 --port 4983",
    "library:text": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/library-text.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "workshop": "storybook dev --port 61000 --host 0.0.0.0 --no-open --disable-telemetry",
    "workshop:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-workshop.ts",
    "build:components": "vite build --config vite.components.config.ts"
  },
  "pre-commit": [
    "pre-commit:staged"
  ],
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@better-auth/core": "^1.7.12",
    "@colordx/core": "^7.3.0",
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "^3.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-complexity": "^4.2.3",
    "@pothos/plugin-relay": "^4.8.1",
    "@pothos/plugin-scope-auth": "^4.2.1",
    "@tanstack/react-query": "^5.104.0",
    "altair-static": "^8.5.9",
    "better-auth": "^1.7.12",
    "dataloader": "^2.2.3",
    "downshift": "^9.4.0",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^6.0.1",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.1",
    "react-hook-form": "^7.89.0",
    "slugify": "^1.6.9",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.9",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@playwright/test": "^1.64.1",
    "@storybook/nextjs-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "chrome-launcher": "1.2.2",
    "drizzle-kit": "^0.31.11",
    "github-slugger": "^2.0.0",
    "happy-dom": "21.0.4",
    "lighthouse": "13.5.0",
    "lint-staged": "^17.6.0",
    "monocart-coverage-reports": "^3.1.0",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "oxlint": "^1.89.0",
    "pdfjs-dist": "^6.4.299",
    "picomatch": "^4.0.7",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "sass": "^1.104.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "storybook": "^10.6.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-plugin-use-baseline": "^1.4.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.5",
    "web-features": "^3.42.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "pre-commit@2.0.0": true
  },
  "browserslist": [
    "baseline widely available"
  ],
  "overrides": {
    "altair-static": {
      "zod": "4.6.7"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
