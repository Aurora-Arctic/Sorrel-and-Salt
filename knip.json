{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,ts}",
    ".github/scripts/**/*.{mjs,js,ts}",
    ".design-sync/**/*.{ts,mjs}",
    "src/db/seed/index.ts",
    "tests/**/*.type-check.ts",
    "tests/support/*-reporter.ts",
    "playwright.*.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}"],
  "ignore": [".storybook/public/mockServiceWorker.js", ".design-sync/dist-index.mjs"],
  "ignoreDependencies": ["server-only"],
  "ignoreBinaries": ["flock"],
  "ignoreExportsUsedInFile": true,
  "next": true,
  "vitest": true,
  "playwright": true,
  "storybook": true
}
